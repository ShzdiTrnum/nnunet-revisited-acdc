# Copy to ~/nnunet_repro/env.sh and edit. Sourced by every script in scripts/.
# Paths below are examples; point them at a disk with enough free space.
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate nnunet
export nnUNet_raw="$HOME/nnunet_repro/nnUNet_raw"
export nnUNet_preprocessed="$HOME/nnunet_repro/nnUNet_preprocessed"
export nnUNet_results="$HOME/nnunet_repro/nnUNet_results"
mkdir -p "$nnUNet_raw" "$nnUNet_preprocessed" "$nnUNet_results" "$HOME/nnunet_repro/logs"
